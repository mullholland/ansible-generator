---
- name: Verify
  hosts: all
  become: true
  gather_facts: true
  vars:
    verify:
      package: "example"
      config_file: ""
      config_line: ""
      config_owner: ""
      config_group: ""
      config_mode: ""
      daemon: ""
      port: ""

{% raw %}
  tasks:
    - name: SmokeTests
      ansible.builtin.debug:
        msg:
          - "ansible_version => {{ansible_version}}"
          - "ansible_distribution => {{ ansible_facts['distribution'] }}"
          - "ansible_distribution_major_version => {{ ansible_facts['distribution_major_version'] }}"
          - "ansible_os_family  => {{ ansible_facts['os_family'] }}"
          - "ansible_system  => {{ ansible_facts['system'] }}"

    - name: Check if package is installed
      ansible.builtin.package:
        name: "{{ verify.package }}"
        state: present
      check_mode: true
      register: package_installed
      failed_when: (package_installed is changed) or (package_installed is failed)

    - name: check {{ verify.config_file }} conf file
      lineinfile:
        name: "{{ verify.config_file }}"
        line: "{{ verify.config_line }}"
        state: present
        owner: "{{ verify.config_owner }}"
        group: "{{ verify.config_group }}"
        mode: "{{ verify.config_mode }}"
      check_mode: true
      register: molecule_hcl
      failed_when: (molecule_hcl is changed) or (molecule_hcl is failed)

    - name: check {{ verify.daemon }} daemon
      service:
        name: "{{ verify.daemon }}"
        state: started
        enabled: true
      check_mode: true
      register: molecule_service
      failed_when: (molecule_service is changed) or (molecule_service is failed)

    - name: check if {{ verify.port }} reachable?
      uri:
        url: "http://{{ ansible_default_ipv4.address|default(ansible_all_ipv4_addresses[0]) }}:8500/v1/health/node/{{ inventory_hostname_short | lower }}"
        method: GET
        status_code: 200
        body_format: json
      register: check_result
      retries: 6
      until: check_result is succeeded
      delay: 10
      changed_when: false
{% endraw %}
